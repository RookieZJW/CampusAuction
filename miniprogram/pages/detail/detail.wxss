.detail-page {
  padding-bottom: 160rpx;
}

.extend-tip {
  font-size: 22rpx;
  color: var(--warning);
  background: #FAEEDA;
  border-radius: 8rpx;
  padding: 10rpx 16rpx;
  margin-bottom: 12rpx;
}

.image-swiper {
  height: 560rpx;
  background: #000000;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.price-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-right: 12rpx;
}

.current-price .price {
  font-size: 48rpx;
}

.bid-count {
  font-size: 24rpx;
  color: var(--text-hint);
}

.meta-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.countdown {
  margin-left: auto;
  font-size: 26rpx;
  color: var(--warning);
}

.countdown.urgent {
  color: var(--danger);
  font-weight: bold;
  font-size: 30rpx;
}

.rules {
  font-size: 24rpx;
  color: var(--text-hint);
  line-height: 1.8;
  border-top: 1rpx solid var(--border);
  padding-top: 16rpx;
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.detail-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: bold;
}

/* W5 收藏按钮 */
.fav-btn {
  font-size: 52rpx;
  color: var(--text-hint);
  margin-left: 20rpx;
  line-height: 1.1;
}

.fav-btn.fav-on {
  color: var(--danger);
}

.seller-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.seller {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin: 12rpx 0;
}

/* W5 举报入口 */
.report-link {
  font-size: 22rpx;
  color: var(--text-hint);
}

.description {
  font-size: 28rpx;
  color: var(--text);
  white-space: pre-wrap;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.bid-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.bid-item:last-child {
  border-bottom: none;
}

.bid-nickname {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.bid-price {
  font-size: 30rpx;
  color: var(--danger);
  font-weight: bold;
}

.bid-time {
  margin-left: 20rpx;
  font-size: 22rpx;
  color: var(--text-hint);
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

/* 出价面板 */
.bid-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.bid-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  z-index: 101;
}

.panel-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
}

.panel-info {
  display: flex;
  justify-content: space-around;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 24rpx;
}

.panel-input-row {
  display: flex;
  align-items: center;
  background: var(--bg);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.panel-unit {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--danger);
  margin-right: 12rpx;
}

.panel-input {
  flex: 1;
  font-size: 40rpx;
  font-weight: bold;
}

.quick-bids {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.quick-btn {
  flex: 1;
  text-align: center;
  margin: 0 8rpx;
  padding: 14rpx 0;
  border: 2rpx solid var(--primary);
  color: var(--primary);
  border-radius: 10rpx;
  font-size: 26rpx;
}

.panel-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-hint);
  margin-bottom: 24rpx;
}

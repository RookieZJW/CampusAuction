.detail-page {
  padding-bottom: 160rpx;
}

.extend-tip {
  font-size: var(--fs-caption);
  color: var(--warning);
  background: var(--warning-light);
  border-left: 4rpx solid var(--kraft);
  border-radius: 0 6rpx 6rpx 0;
  padding: 10rpx 16rpx;
  margin-bottom: 12rpx;
}

.image-swiper {
  height: 520rpx;
  background: #2C2A26;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

/* ---- 价签卡 ---- */
.price-card {
  padding: 26rpx 24rpx 22rpx;
  overflow: hidden;
}

.price-card::after {
  content: '';
  position: absolute;
  right: -28rpx;
  bottom: -28rpx;
  width: 120rpx;
  height: 120rpx;
  border: 1rpx solid var(--border);
  border-radius: 50%;
  opacity: 0.6;
}

.price-kicker {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 12rpx;
  font-size: var(--fs-label);
  letter-spacing: 2rpx;
  color: var(--text-hint);
}

.price-no {
  font-family: var(--font-num);
  letter-spacing: 2rpx;
  color: var(--brick);
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 14rpx;
}

.price-label {
  font-size: var(--fs-meta);
  color: var(--text-secondary);
  margin-right: 12rpx;
}

.current-price .price {
  font-size: 56rpx;
  line-height: 1.1;
  letter-spacing: 1rpx;
}

.bid-count {
  font-size: var(--fs-meta);
  color: var(--text-hint);
}

.meta-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.countdown {
  margin-left: auto;
  font-size: 26rpx;
  color: var(--kraft);
  letter-spacing: 1rpx;
}

.countdown.urgent {
  color: var(--danger);
  font-weight: 600;
  font-size: 28rpx;
}

.rules {
  font-size: var(--fs-caption);
  color: var(--text-hint);
  line-height: 1.8;
  border-top: 1rpx dashed var(--border);
  padding-top: 16rpx;
}

/* ---- 标题与描述 ---- */
.title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.detail-title {
  flex: 1;
  font-size: var(--fs-title);
  font-weight: 600;
  line-height: 1.45;
  letter-spacing: 1rpx;
}

/* 收藏按钮 */
.fav-btn {
  font-size: 48rpx;
  color: var(--text-hint);
  margin-left: 20rpx;
  line-height: 1.1;
}

.fav-btn.fav-on {
  color: var(--danger);
}

.seller-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.seller {
  font-size: var(--fs-meta);
  color: var(--text-secondary);
  margin: 14rpx 0;
}

/* 举报入口 */
.report-link {
  font-size: var(--fs-caption);
  color: var(--text-hint);
  border-bottom: 1rpx solid var(--border);
  padding-bottom: 2rpx;
}

.description {
  font-size: var(--fs-body);
  color: var(--text);
  line-height: 1.75;
  white-space: pre-wrap;
  border-top: 1rpx solid var(--border);
  padding-top: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  align-items: center;
  margin-bottom: 12rpx;
}

.bid-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx dashed var(--border);
}

.bid-item:last-child {
  border-bottom: none;
}

.bid-nickname {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.bid-price {
  font-size: 30rpx;
  color: var(--danger);
  font-weight: 600;
}

.bid-time {
  margin-left: 20rpx;
  font-size: var(--fs-caption);
  color: var(--text-hint);
}

/* ---- 底部操作栏 ---- */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 40rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--card-bg);
  border-top: 1rpx solid var(--border);
  box-shadow: 0 -4rpx 18rpx rgba(39, 51, 62, 0.05);
}

/* ---- 出价面板 ---- */
.bid-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(27, 54, 84, 0.44);
  z-index: 100;
}

.bid-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--card-bg);
  border-top: 2rpx solid var(--primary);
  border-radius: 16rpx 16rpx 0 0;
  padding: 36rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  z-index: 101;
  box-shadow: 0 -10rpx 30rpx rgba(27, 54, 84, 0.12);
}

.panel-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  margin-bottom: 24rpx;
}

.panel-info {
  display: flex;
  justify-content: space-around;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 24rpx;
}

.panel-input-row {
  display: flex;
  align-items: center;
  background: var(--bg-deep);
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 20rpx;
}

.panel-unit {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--danger);
  margin-right: 12rpx;
}

.panel-input {
  flex: 1;
  font-size: 40rpx;
  font-weight: 600;
}

.quick-bids {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.quick-btn {
  flex: 1;
  text-align: center;
  margin: 0 8rpx;
  padding: 14rpx 0;
  border: 1rpx solid var(--primary-soft);
  color: var(--primary);
  background: var(--primary-light);
  border-radius: 6rpx;
  font-size: 26rpx;
}

.quick-btn:active {
  background: var(--primary);
  color: #FFFFFF;
}

.panel-tip {
  text-align: center;
  font-size: var(--fs-caption);
  color: var(--text-hint);
  margin-bottom: 24rpx;
}

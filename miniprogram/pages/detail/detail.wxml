<view class="detail-page" wx:if="{{detail}}">
  <!-- 图集 -->
  <swiper class="image-swiper" indicator-dots circular="{{detail.images.length > 1}}">
    <swiper-item wx:for="{{detail.images}}" wx:key="index">
      <image src="{{item}}" mode="aspectFill" class="swiper-image"
             bindtap="onPreviewImage" data-index="{{index}}" />
    </swiper-item>
    <swiper-item wx:if="{{!detail.images.length}}">
      <image src="/images/placeholder.png" mode="aspectFill" class="swiper-image" />
    </swiper-item>
  </swiper>

  <!-- 价格与状态：一张价签 -->
  <view class="card price-card">
    <view class="price-kicker">
      <text>当前竞价</text>
      <text class="price-no">LIVE / {{detail.id}}</text>
    </view>
    <view class="price-row">
      <view class="current-price">
        <text class="price-label">当前价</text>
        <text class="price">¥{{currentPriceYuan}}</text>
      </view>
      <view class="bid-count">{{detail.bidCount}} 次出价</view>
    </view>
    <view class="meta-row">
      <text wx:if="{{detail.schoolName}}" class="tag school-tag">{{detail.schoolName}} · 本校拍场</text>
      <text class="tag">{{detail.categoryName}}</text>
      <text class="tag">{{detail.condition}}</text>
      <view class="countdown {{urgent ? 'urgent' : ''}}">
        {{detail.status === 'ONGOING' ? countdownLabel : statusText}}
      </view>
    </view>
    <view wx:if="{{extendedTip}}" class="extend-tip">本场拍卖已被出价延长 2 分钟（防狙击）</view>
    <view class="rules">
      <view>起拍价 ¥{{startPriceYuan}} · 加价幅度 ¥{{incrementYuan}}</view>
      <view>参拍需冻结保证金 ¥10.00（虚拟余额）· 结束前 5 分钟出价自动延时</view>
    </view>
  </view>

  <!-- 标题与描述 -->
  <view class="card">
    <view class="title-row">
      <view class="detail-title">{{detail.title}}</view>
      <view class="fav-btn {{collected ? 'fav-on' : ''}}" bindtap="onToggleFavorite">{{collected ? '♥' : '♡'}}</view>
    </view>
    <view class="seller-row">
      <text class="seller">卖家：{{detail.sellerNickname || '微信用户'}}</text>
      <text class="report-link" bindtap="onReportTap">举报</text>
    </view>
    <view class="description">{{detail.description || '暂无描述'}}</view>
  </view>

  <!-- 出价记录 -->
  <view class="card">
    <view class="section-title section-head">出价记录（{{detail.bidCount}}）</view>
    <view wx:if="{{!detail.bidRecords.length}}" class="empty" style="padding: 40rpx 0;">
      还没有人出价，来做第一个吧
    </view>
    <view class="bid-item" wx:for="{{detail.bidRecords}}" wx:key="index">
      <text class="bid-nickname">{{item.nickname}}</text>
      <text class="bid-price">¥{{item.priceYuan}}</text>
      <text class="bid-time">{{item.bidTimeText}}</text>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <button class="btn-primary bid-btn" bindtap="onBidTap"
            disabled="{{detail.status !== 'ONGOING' || bidding}}">
      {{bidding ? '出价中...' : (detail.status === 'ONGOING' ? '我要出价' : statusText)}}
    </button>
  </view>

  <!-- 出价面板遮罩 -->
  <view class="bid-mask" wx:if="{{showBidPanel}}" bindtap="onCloseBidPanel"></view>
  <!-- 出价面板 -->
  <view class="bid-panel" wx:if="{{showBidPanel}}">
    <view class="panel-title">出价</view>
    <view class="panel-info">
      <view>当前价 <text class="price">¥{{currentPriceYuan}}</text></view>
      <view>最低出价 <text class="price">¥{{minNextYuan}}</text></view>
    </view>
    <view class="panel-input-row">
      <text class="panel-unit">¥</text>
      <input class="panel-input" type="digit" value="{{bidYuan}}"
             bindinput="onBidInput" focus="{{true}}" placeholder="输入出价金额（元）" />
    </view>
    <view class="quick-bids">
      <view class="quick-btn" wx:for="{{quickBids}}" wx:key="*this"
            bindtap="onQuickBid" data-price="{{item}}">¥{{item}}</view>
    </view>
    <view class="panel-tip">出价将冻结保证金 ¥10.00，未中标自动解冻</view>
    <button class="btn-primary" bindtap="onConfirmBid" loading="{{bidding}}">确认出价</button>
  </view>
</view>

<view wx:elif="{{loading}}" class="empty">加载中...</view>
<view wx:else class="empty">拍卖不存在或已下架</view>

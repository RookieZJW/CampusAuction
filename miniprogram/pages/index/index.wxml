<view class="index-page">
  <!-- 公告栏：像贴在宿舍楼下布告板上的一张通知 -->
  <view class="board">
    <view class="board-tape"></view>
    <view class="board-top">
      <text class="board-no">NO. 01 / 拍场公告</text>
      <view class="board-live"><text class="live-dot"></text><text>正在进行</text></view>
    </view>
    <view class="board-title">本周拍场</view>
    <view class="board-desc">教材、单车、小台灯，都是学长学姐用过的东西</view>
    <view class="board-foot">
      <view class="board-stat">
        <text class="board-count">{{auctionList.length}}</text>
        <text class="board-unit">件在拍</text>
      </view>
      <text class="board-rule">{{today}} · {{schoolLabel}}</text>
    </view>
  </view>

  <!-- 分类横滑条：纸条式的筛选签 -->
  <scroll-view class="category-bar" scroll-x>
    <view
      class="category-item {{activeCategory === 0 ? 'active' : ''}}"
      data-id="0"
      bindtap="onCategoryTap">全部</view>
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="category-item {{activeCategory === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onCategoryTap">{{item.name}}</view>
  </scroll-view>

  <!-- 拍卖列表 -->
  <view wx:if="{{loading}}" class="empty">正在翻公告板…</view>
  <view wx:elif="{{auctionList.length === 0}}" class="empty">
    <view>公告板上还空着</view>
    <view class="empty-sub">去「发布」贴上第一件闲置吧</view>
  </view>
  <block wx:else>
    <view class="list-head section-head">正在进行的拍品</view>
    <view
      wx:for="{{auctionList}}"
      wx:key="id"
      class="card auction-card"
      bindtap="onAuctionTap"
      data-id="{{item.id}}">
      <image class="auction-cover" src="{{item.coverImage}}" mode="aspectFill" />
      <view class="auction-info">
        <view class="auction-title">{{item.title}}</view>
        <view class="auction-meta">
          <text class="tag">{{item.categoryName}}</text>
          <text class="tag">{{item.condition}}</text>
        </view>
        <view class="auction-price-row">
          <text class="price">¥{{item.currentPriceYuan}}</text>
          <text class="bid-count">{{item.bidCount}} 次出价</text>
        </view>
        <view class="countdown {{item.urgent ? 'urgent' : ''}}">
          <text class="countdown-dot"></text>距结束 {{item.countdownText}}
        </view>
      </view>
    </view>
    <view wx:if="{{noMore}}" class="list-end">— 翻到底了 —</view>
  </block>
</view>

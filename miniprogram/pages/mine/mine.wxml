<view class="mine-page">
  <!-- 用户信息区：像一张夹在笔记本里的参拍名片 -->
  <view class="user-card card">
    <view class="id-strip">
      <text class="id-label">我的参拍名片</text>
      <text class="id-mark">ID / 01</text>
    </view>
    <view class="id-main">
      <block wx:if="{{userInfo}}">
        <image class="avatar" src="{{userInfo.avatar || '/images/placeholder.png'}}" mode="aspectFill" />
        <view class="user-info">
          <view class="nickname">{{userInfo.nickname}}</view>
          <view class="stats">
            <text>余额 ¥{{balanceYuan}}</text>
            <text class="divider">·</text>
            <text>信用 {{userInfo.creditScore}}</text>
          </view>
        </view>
      </block>
      <block wx:else>
        <view class="avatar avatar-empty">?</view>
        <view class="user-info">
          <view class="nickname">还没登录</view>
          <view class="stats">登录后才能出价和面交</view>
        </view>
        <button class="btn-login" bindtap="onLoginTap">去登录</button>
      </block>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="menu card">
    <view class="menu-item" bindtap="onMenuTap" data-url="/packageUser/pages/profile/profile">
      <text>完善资料</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onMenuTap" data-url="/packageUser/pages/my-items/my-items">
      <text>我发布的</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onMenuTap" data-url="/packageUser/pages/my-bids/my-bids">
      <text>我的出价</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onMenuTap" data-url="/packageUser/pages/my-orders/my-orders">
      <text>我的订单</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onMenuTap" data-url="/packageUser/pages/wallet/wallet">
      <text>钱包流水</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onMenuTap" data-url="/packageUser/pages/credit/credit">
      <text>信用分</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onMenuTap" data-url="/packageUser/pages/notifications/notifications">
      <text>消息中心</text>
      <view class="menu-right">
        <text class="unread-tip" wx:if="{{unread > 0}}">{{unread}} 条未读</text>
        <text class="arrow">›</text>
      </view>
    </view>
    <view class="menu-item" bindtap="onMenuTap" data-url="/packageUser/pages/my-reviews/my-reviews">
      <text>我的评价</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onMenuTap" data-url="/packageUser/pages/favorites/favorites">
      <text>我的收藏</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onMenuTap" data-url="/packageAdmin/pages/audit/audit" data-admin="true">
      <text>管理员审核</text><text class="arrow">›</text>
    </view>
  </view>

  <view wx:if="{{userInfo}}" class="logout-row">
    <button class="btn-ghost logout-btn" bindtap="onLogout">退出登录</button>
  </view>
</view>

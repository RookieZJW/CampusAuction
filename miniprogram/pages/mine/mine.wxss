.mine-page {
  padding-bottom: 60rpx;
}

/* ---- 参拍名片 ---- */
.user-card {
  margin-top: 24rpx;
  padding: 0;
  overflow: hidden;
}

.id-strip {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 24rpx;
  background: var(--primary-light);
  border-bottom: 1rpx solid var(--primary-soft);
}

.id-label {
  font-size: var(--fs-caption);
  letter-spacing: 2rpx;
  color: var(--primary-deep);
}

.id-mark {
  font-size: var(--fs-label);
  letter-spacing: 2rpx;
  color: var(--primary);
  font-family: var(--font-num);
}

.id-main {
  display: flex;
  align-items: center;
  padding: 26rpx 24rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--bg-deep);
  border: 2rpx solid var(--card-bg);
  box-shadow: 0 0 0 1rpx var(--border);
  flex-shrink: 0;
}

.avatar-empty {
  line-height: 108rpx;
  text-align: center;
  font-size: 44rpx;
  color: var(--text-hint);
}

.user-info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.nickname {
  font-size: var(--fs-title);
  font-weight: 600;
  letter-spacing: 1rpx;
  color: var(--text);
}

.user-phone {
  margin-top: 4rpx;
  font-size: var(--fs-meta);
  color: var(--text-hint);
  font-family: var(--font-num);
}

.stats {
  margin-top: 8rpx;
  font-size: var(--fs-meta);
  color: var(--text-secondary);
}

.stats .divider {
  margin: 0 14rpx;
  color: var(--brick);
}

.btn-login {
  background: var(--primary);
  color: #FFFFFF;
  font-size: var(--fs-meta);
  border-radius: 8rpx;
  height: 64rpx;
  line-height: 1.4;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  letter-spacing: 1rpx;
  text-indent: 1rpx;
}

.btn-login::after {
  border: none;
}

/* ---- 功能目录：每条前面一个小方点 ---- */
.menu {
  padding: 0 24rpx;
}

.menu-item {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 96rpx;
  padding-left: 26rpx;
  border-bottom: 1rpx solid var(--border);
  font-size: 28rpx;
  color: var(--text);
}

.menu-item::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 50%;
  width: 8rpx;
  height: 8rpx;
  margin-top: -4rpx;
  background: var(--primary-soft);
  border-radius: 1rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: var(--bg-deep);
}

.arrow {
  color: var(--text-hint);
  font-size: 30rpx;
}

.menu-right {
  display: flex;
  align-items: center;
}

.unread-tip {
  color: var(--danger);
  font-size: var(--fs-caption);
  margin-right: 12rpx;
}

.user-school {
  font-size: var(--fs-caption);
  color: var(--moss);
  margin-top: 6rpx;
}
.user-school.unverified {
  color: var(--warning);
}
.user-school.pending-text {
  color: var(--kraft);
}
.school-tag {
  font-size: var(--fs-caption);
  color: var(--moss);
  margin-right: 10rpx;
}

.logout-row {
  padding: 0 24rpx;
  margin-top: 36rpx;
}

.logout-btn {
  color: var(--danger);
  border-color: var(--danger);
  height: 88rpx;
  line-height: 1.4;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

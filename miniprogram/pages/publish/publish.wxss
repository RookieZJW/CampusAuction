.publish-page {
  padding-bottom: 160rpx;
}

/* ---- 表单分区：编号像登记表上的栏目 ---- */
.form-title {
  display: flex;
  align-items: baseline;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  margin-bottom: 24rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid var(--border);
}

.form-no {
  font-family: var(--font-num);
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: var(--brick);
  margin-right: 16rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.label {
  font-size: var(--fs-meta);
  color: var(--text-secondary);
  margin-bottom: 10rpx;
  letter-spacing: 1rpx;
}

/* 输入区：淡淡一笔底纹，像写在横线纸上 */
.input,
.textarea,
.picker-value {
  background: var(--bg-deep);
  border: 1rpx solid var(--border);
  border-radius: 6rpx;
  padding: 18rpx 20rpx;
  font-size: var(--fs-body);
  color: var(--text);
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
}

.picker-value.placeholder {
  color: var(--text-hint);
}

.image-list {
  display: flex;
  flex-wrap: wrap;
}

.image-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  margin: 0 20rpx 20rpx 0;
}

.image-item image {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
  border: 1rpx solid var(--border);
}

.image-delete {
  position: absolute;
  right: -12rpx;
  top: -12rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--danger);
  color: #FFFFFF;
  font-size: 28rpx;
  box-shadow: 0 2rpx 6rpx rgba(39, 51, 62, 0.16);
}

.image-add {
  width: 180rpx;
  height: 180rpx;
  border: 2rpx dashed var(--border);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: var(--text-hint);
  background: var(--bg-deep);
}

.deposit-tip {
  font-size: var(--fs-caption);
  color: var(--warning);
  background: var(--warning-light);
  border-left: 4rpx solid var(--kraft);
  border-radius: 0 6rpx 6rpx 0;
  padding: 14rpx 20rpx;
  line-height: 1.6;
}

/* ---- 估价便签 ---- */
.label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.ai-trigger {
  color: var(--primary);
  font-size: var(--fs-caption);
  border-bottom: 1rpx solid var(--primary-soft);
  padding-bottom: 2rpx;
}

.ai-suggest {
  position: relative;
  background: var(--primary-light);
  border: 1rpx solid var(--primary-soft);
  border-left: 6rpx solid var(--primary);
  border-radius: 6rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 28rpx;
}

.ai-suggest-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ai-badge {
  font-size: var(--fs-label);
  letter-spacing: 1rpx;
  padding: 3rpx 14rpx;
  border-radius: 4rpx;
  color: #FFFFFF;
}

.ai-badge-ai {
  background: var(--primary);
}

.ai-badge-rule {
  background: var(--kraft);
}

.ai-suggest-range {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--primary-deep);
}

.ai-suggest-reason {
  font-size: var(--fs-caption);
  color: var(--text-secondary);
  margin-top: 10rpx;
  line-height: 1.6;
}

.ai-suggest-actions {
  display: flex;
  margin-top: 16rpx;
}

.ai-apply {
  flex: 1;
  text-align: center;
  background: var(--primary);
  color: #FFFFFF;
  font-size: var(--fs-caption);
  border-radius: 6rpx;
  padding: 10rpx 0;
  margin-right: 16rpx;
  letter-spacing: 1rpx;
}

.ai-dismiss {
  width: 120rpx;
  text-align: center;
  color: var(--text-hint);
  font-size: var(--fs-caption);
  padding: 10rpx 0;
}

/* ---- 底部提交条 ---- */
.submit-area {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 40rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--card-bg);
  border-top: 1rpx solid var(--border);
  box-shadow: 0 -4rpx 18rpx rgba(39, 51, 62, 0.05);
}

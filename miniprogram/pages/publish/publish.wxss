.publish-page {
  padding-bottom: 160rpx;
}

.form-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 10rpx;
}

.input,
.textarea,
.picker-value {
  background: var(--bg);
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
}

.picker-value.placeholder {
  color: var(--text-hint);
}

.image-list {
  display: flex;
  flex-wrap: wrap;
}

.image-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  margin: 0 20rpx 20rpx 0;
}

.image-item image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.image-delete {
  position: absolute;
  right: -12rpx;
  top: -12rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--danger);
  color: #ffffff;
  font-size: 28rpx;
}

.image-add {
  width: 180rpx;
  height: 180rpx;
  border: 2rpx dashed var(--border);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  color: var(--text-hint);
}

.deposit-tip {
  font-size: 22rpx;
  color: #854F0B;
  background: #FAEEDA;
  border-radius: 8rpx;
  padding: 14rpx 20rpx;
}

/* ---- AI 定价建议（W5） ---- */
.label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.ai-trigger {
  color: var(--primary);
  font-size: 24rpx;
}

.ai-suggest {
  background: var(--primary-light);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 28rpx;
}

.ai-suggest-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ai-badge {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  color: #ffffff;
}

.ai-badge-ai {
  background: var(--primary);
}

.ai-badge-rule {
  background: var(--warning);
}

.ai-suggest-range {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--primary);
}

.ai-suggest-reason {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 10rpx;
}

.ai-suggest-actions {
  display: flex;
  margin-top: 16rpx;
}

.ai-apply {
  flex: 1;
  text-align: center;
  background: var(--primary);
  color: #ffffff;
  font-size: 24rpx;
  border-radius: 32rpx;
  padding: 10rpx 0;
  margin-right: 16rpx;
}

.ai-dismiss {
  width: 120rpx;
  text-align: center;
  color: var(--text-hint);
  font-size: 24rpx;
  padding: 10rpx 0;
}

.submit-area {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

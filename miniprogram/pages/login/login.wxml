<view class="login-page">
  <view class="logo-area">
    <view class="logo-icon">拍</view>
    <view class="app-name">校园拍场</view>
    <view class="app-slogan">闲置好物 · 价高者得 · 校园面交</view>
    <view class="login-note">用微信登录，方便联系卖家面交</view>
  </view>

  <view class="login-area">
    <button class="btn-primary" bindtap="onWxLogin" loading="{{loading}}">
      微信一键登录
    </button>
    <view class="privacy-tip">
      <view>登录只用于识别身份，不会获取头像、昵称和手机号</view>
      <text class="privacy-link" bindtap="onOpenPrivacyContract">查看《用户隐私保护指引》</text>
    </view>
  </view>
</view>

<view class="login-mask" bindtap="onMaskTap">
  <view class="login-sheet" catchtap="onSheetTap">
    <!-- 票头 -->
    <view class="sheet-head">
      <view class="head-brand">
        <view class="brand-stamp">拍</view>
        <view class="head-titles">
          <view class="brand-title">校园拍场</view>
          <view class="brand-en">CAMPUS AUCTION · 闲置流转</view>
        </view>
      </view>
      <view class="brand-slogan">填好资料，同学才好认出你</view>
      <view class="sheet-close" bindtap="onClose" aria-label="关闭">×</view>
    </view>

    <!-- 登记表主体 -->
    <view class="register-body">
      <!-- 头像 -->
      <view class="avatar-row">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image class="avatar-img" src="{{avatarDisplay || '/images/placeholder.png'}}" mode="aspectFill" />
          <view class="avatar-cam">✎</view>
        </button>
        <view class="avatar-tip">
          <view class="tip-title">你的头像</view>
          <view class="tip-desc">点一下换张照片</view>
        </view>
      </view>

      <!-- 01 昵称 -->
      <view class="field-block">
        <view class="field-head">
          <text class="field-no">01</text>
          <text class="field-label">昵称</text>
        </view>
        <input class="field-input" type="nickname" placeholder="填个同学认得出的名字"
               value="{{nickname}}" maxlength="32"
               bindinput="onNicknameInput" bindblur="onNicknameBlur" />
      </view>

      <!-- 02 手机号 -->
      <view class="field-block">
        <view class="field-head">
          <text class="field-no">02</text>
          <text class="field-label">手机号</text>
        </view>
        <button class="phone-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">
          <text class="phone-icon">＋</text>
          <text class="phone-text">{{phoneReady ? '已授权，点此可重新授权' : '手机号快捷登录'}}</text>
          <text class="phone-arrow">›</text>
        </button>
        <view wx:if="{{phoneReady}}" class="phone-hint">授权成功，登录时会绑定到你的账号</view>
        <view wx:if="{{privacyDeclined}}" class="privacy-reagree" bindtap="onReopenPrivacy">还没同意隐私指引，点此重新查看</view>
      </view>
    </view>

    <!-- 登录 -->
    <view class="submit-area">
      <button class="btn-login" bindtap="onLogin" loading="{{loading}}" disabled="{{loading}}">登 录</button>
      <view class="agreement-row">
        <view class="checkbox {{agreed ? 'checked' : ''}}" bindtap="onToggleAgree">
          <view wx:if="{{agreed}}" class="checkbox-mark">✓</view>
        </view>
        <view class="agreement-text">
          已阅读并同意
          <text class="link" data-type="user" catchtap="onOpenAgreement">用户协议</text>
          和
          <text class="link" data-type="privacy" catchtap="onOpenAgreement">隐私政策</text>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 微信隐私保护指引授权弹窗：用户主动同意，不默认勾选，不同意也可关闭登录卡片继续逛 -->
<view class="privacy-mask" wx:if="{{showPrivacy}}">
  <view class="privacy-panel">
    <view class="privacy-title">先看一下隐私说明</view>
    <view class="privacy-text">
      登录时我们会向你收集手机号、头像和昵称：手机号用于登录与面交联系，头像昵称用于出价记录展示。这些信息只在你主动授权后才会获取，拒绝也能继续逛拍场。
    </view>
    <button class="privacy-link" bindtap="onOpenPrivacyContract">查看{{privacyContractName}}</button>
    <view class="privacy-actions">
      <button class="privacy-disagree" bindtap="onDisagreePrivacy">先不同意</button>
      <button id="agree-btn" class="privacy-agree"
              open-type="agreePrivacyAuthorization"
              bindagreeprivacyauthorization="onAgreePrivacy">同意并继续</button>
    </view>
  </view>
</view>

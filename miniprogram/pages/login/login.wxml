<view class="login-mask" bindtap="onMaskTap">
  <view class="login-sheet" catchtap="onSheetTap">
    <!-- 关闭 -->
    <view class="sheet-close" bindtap="onClose" aria-label="关闭">×</view>

    <!-- 品牌区：沿用纸感校园视觉，不用 WorkBuddy 机器人形象 -->
    <view class="sheet-brand">
      <view class="brand-stamp">拍</view>
      <view class="brand-title">校园拍场</view>
      <view class="brand-slogan">闲置好物 · 价高者得 · 校园面交</view>
    </view>

    <!-- 主登录方式 -->
    <block wx:if="{{mode === 'main'}}">
      <button class="btn-wx" bindtap="onWxLogin" loading="{{loading}}" disabled="{{loading}}">
        微信登录
      </button>

      <view class="alt-row">
        <button class="alt-item" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber"
                disabled="{{phoneLoading}}">
          <view class="alt-icon alt-icon-phone">▣</view>
          <view class="alt-label">手机号</view>
        </button>
        <view class="alt-item" bindtap="onSwitchMode" data-mode="email">
          <view class="alt-icon alt-icon-mail">✉</view>
          <view class="alt-label">邮箱登录</view>
        </view>
      </view>
    </block>

    <!-- 邮箱登录子页 -->
    <block wx:else>
      <view class="email-form">
        <input class="field" type="text" placeholder="输入邮箱地址" value="{{email}}"
               bindinput="onEmailInput" maxlength="64" />
        <view class="code-row">
          <input class="field code-field" type="number" placeholder="验证码" value="{{emailCode}}"
                 bindinput="onCodeInput" maxlength="6" />
          <button class="code-btn" bindtap="onSendCode" disabled="{{countdown > 0 || sending}}">
            {{countdown > 0 ? countdown + 's' : (sending ? '发送中' : '获取验证码')}}
          </button>
        </view>
        <view wx:if="{{devMode && devCode}}" class="dev-hint">演示验证码：{{devCode}}</view>
        <button class="btn-wx" bindtap="onEmailLogin" loading="{{emailLoading}}" disabled="{{emailLoading}}">
          邮箱登录
        </button>
        <view class="back-link" bindtap="onSwitchMode" data-mode="main">‹ 返回其他登录方式</view>
      </view>
    </block>

    <!-- 协议勾选：不默认勾选 -->
    <view class="agreement-row">
      <view class="checkbox {{agreed ? 'checked' : ''}}" bindtap="onToggleAgree">
        <view wx:if="{{agreed}}" class="checkbox-mark">✓</view>
      </view>
      <view class="agreement-text">
        已阅读并同意
        <text class="link" data-type="user" catchtap="onOpenAgreement">用户协议</text>
        和
        <text class="link" data-type="privacy" catchtap="onOpenAgreement">隐私政策</text>
      </view>
    </view>
  </view>
</view>

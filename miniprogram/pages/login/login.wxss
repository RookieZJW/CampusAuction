/* 登录弹窗｜校园拍卖会登记表：深蓝票头 + 撕口虚线 + 编号字段 */
.login-mask {
  position: fixed;
  inset: 0;
  background: rgba(20, 26, 34, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 40rpx;
  box-sizing: border-box;
}

.login-sheet {
  position: relative;
  width: 640rpx;
  max-width: 100%;
  background: var(--card-bg);
  border-radius: 16rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.3);
  overflow: hidden;
}

/* ---- 票头：深蓝墨块，底部一道撕口虚线 ---- */
.sheet-head {
  position: relative;
  background: var(--primary-deep);
  padding: 40rpx 40rpx 36rpx;
}

.sheet-head::after {
  content: '';
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 0;
  height: 1rpx;
  background-image: linear-gradient(to right, rgba(255, 255, 255, 0.42) 50%, transparent 0);
  background-size: 14rpx 1rpx;
}

.head-brand {
  display: flex;
  align-items: center;
}

.brand-stamp {
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 8rpx;
  background: #FFFFFF;
  color: var(--primary-deep);
  font-size: 42rpx;
  font-weight: 600;
  letter-spacing: 0;
  margin-right: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
}

.head-titles {
  display: flex;
  flex-direction: column;
}

.brand-title {
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  color: #FFFFFF;
  line-height: 1.3;
}

.brand-en {
  margin-top: 4rpx;
  font-size: var(--fs-label);
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, 0.62);
  font-family: var(--font-num);
}

.brand-slogan {
  margin-top: 22rpx;
  font-size: var(--fs-caption);
  color: rgba(255, 255, 255, 0.78);
  letter-spacing: 1rpx;
}

.sheet-close {
  position: absolute;
  right: 24rpx;
  top: 20rpx;
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* ---- 登记表主体 ---- */
.register-body {
  padding: 36rpx 40rpx 8rpx;
}

/* 头像：圆形 + 右下角铅笔角标，右侧说明 */
.avatar-row {
  display: flex;
  align-items: center;
  padding-bottom: 32rpx;
  margin-bottom: 8rpx;
  border-bottom: 1rpx solid var(--border);
}

.avatar-btn {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  padding: 0;
  margin: 0 24rpx 0 0;
  background: transparent;
  border: none;
  line-height: 1;
  flex-shrink: 0;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 2rpx solid var(--primary-soft);
  background: var(--bg-deep);
}

.avatar-cam {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--primary);
  color: #FFFFFF;
  font-size: 20rpx;
  border: 2rpx solid var(--card-bg);
}

.avatar-tip {
  display: flex;
  flex-direction: column;
}

.tip-title {
  font-size: var(--fs-body);
  font-weight: 500;
  color: var(--text);
}

.tip-desc {
  margin-top: 4rpx;
  font-size: var(--fs-caption);
  color: var(--text-hint);
}

/* 编号字段 */
.field-block {
  margin-top: 28rpx;
}

.field-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.field-no {
  font-family: var(--font-num);
  font-size: var(--fs-caption);
  color: var(--brick);
  letter-spacing: 1rpx;
  margin-right: 12rpx;
}

.field-label {
  font-size: var(--fs-body);
  font-weight: 500;
  color: var(--text-secondary);
}

.field-input {
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--border);
  border-radius: 10rpx;
  background: #FFFFFF;
  font-size: var(--fs-body);
  color: var(--text);
}

.phone-btn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding: 0 24rpx;
  background: var(--primary-light);
  color: var(--primary-deep);
  font-size: var(--fs-body);
  border: 1rpx solid var(--primary-soft);
  border-radius: 10rpx;
  text-align: left;
}

.phone-btn::after {
  border: none;
}

.phone-icon {
  font-size: 34rpx;
  line-height: 1;
  margin-right: 14rpx;
  color: var(--primary);
}

.phone-text {
  flex: 1;
}

.phone-arrow {
  font-size: 40rpx;
  line-height: 1;
  color: var(--primary);
  opacity: 0.6;
}

.phone-hint {
  margin-top: 10rpx;
  font-size: var(--fs-caption);
  color: var(--moss);
}

.privacy-reagree {
  margin-top: 10rpx;
  font-size: var(--fs-caption);
  color: var(--primary);
  text-decoration: underline;
}

/* ---- 提交区：墨蓝实心按钮，非纯黑 ---- */
.submit-area {
  padding: 32rpx 40rpx 40rpx;
}

.btn-login {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: var(--primary-deep);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
  border-radius: 12rpx;
  border: none;
  padding: 0;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.14);
}

.btn-login::after {
  border: none;
}

.agreement-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 26rpx;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #B9B4A8;
  border-radius: 50%;
  margin-right: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkbox.checked {
  background: var(--primary);
  border-color: var(--primary);
}

.checkbox-mark {
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 1;
}

.agreement-text {
  font-size: var(--fs-caption);
  color: var(--text-hint);
}

.link {
  color: var(--primary);
}

/* ---- 微信隐私保护指引授权弹窗（层级高于登录遮罩 1000）---- */
.privacy-mask {
  position: fixed;
  inset: 0;
  background: rgba(20, 26, 34, 0.62);
  z-index: 1200;
  display: flex;
  align-items: center;
  justify-content: center;
}

.privacy-panel {
  width: 600rpx;
  max-width: 88vw;
  background: var(--card-bg);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.28);
}

.privacy-title {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: var(--primary-deep);
}

.privacy-text {
  margin-top: 18rpx;
  font-size: var(--fs-meta);
  color: var(--text-secondary);
  line-height: 1.75;
}

.privacy-link {
  background: transparent;
  color: var(--primary);
  font-size: var(--fs-caption);
  text-align: left;
  padding: 0;
  margin-top: 18rpx;
  line-height: 1.6;
}

.privacy-link::after {
  border: none;
}

.privacy-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.privacy-disagree,
.privacy-agree {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 26rpx;
  border-radius: 10rpx;
  margin: 0;
}

.privacy-disagree {
  background: var(--bg-deep);
  color: var(--text-secondary);
  border: 1rpx solid var(--border);
}

.privacy-agree {
  background: var(--primary);
  color: #FFFFFF;
}

.privacy-disagree::after,
.privacy-agree::after {
  border: none;
}

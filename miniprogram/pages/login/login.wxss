/* 登录弹窗：半透明遮罩 + 居中纸卡，仿 WorkBuddy 布局但沿用本项目纸感视觉 */
.login-mask {
  position: fixed;
  inset: 0;
  background: rgba(20, 26, 34, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.login-sheet {
  position: relative;
  width: 640rpx;
  max-width: 88vw;
  background: var(--card-bg);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 72rpx 48rpx 48rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.25);
}

/* 顶部一道压痕 */
.login-sheet::before {
  content: '';
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  top: 20rpx;
  height: 1rpx;
  background: var(--border);
}

.sheet-close {
  position: absolute;
  right: 28rpx;
  top: 18rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 50rpx;
  text-align: center;
  font-size: 44rpx;
  color: var(--text-hint);
}

.sheet-brand {
  text-align: center;
  margin-bottom: 56rpx;
}

.brand-stamp {
  width: 112rpx;
  height: 112rpx;
  line-height: 112rpx;
  margin: 0 auto 24rpx;
  border-radius: 12rpx;
  background: var(--primary-deep);
  color: #FFFFFF;
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  box-shadow: 0 8rpx 18rpx rgba(27, 54, 84, 0.18);
}

.brand-title {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  color: var(--primary-deep);
}

.brand-slogan {
  margin-top: 10rpx;
  font-size: var(--fs-caption);
  color: var(--text-hint);
  letter-spacing: 1rpx;
}

/* 微信登录主按钮：黑色实心，仿 WorkBuddy */
.btn-wx {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #1A1A1A;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  border-radius: 14rpx;
  border: none;
  padding: 0;
}

.btn-wx::after {
  border: none;
}

.alt-row {
  display: flex;
  justify-content: center;
  gap: 80rpx;
  margin-top: 44rpx;
}

.alt-item {
  width: 160rpx;
  background: transparent;
  border: none;
  padding: 0;
  line-height: 1.4;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.alt-item::after {
  border: none;
}

.alt-icon {
  width: 92rpx;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 50%;
  background: #F0EDE4;
  color: var(--primary-deep);
  font-size: 40rpx;
  text-align: center;
  margin-bottom: 14rpx;
}

.alt-icon-mail {
  background: #E7EEF3;
}

.alt-label {
  font-size: var(--fs-meta);
  color: var(--text-secondary);
}

/* 邮箱登录表单 */
.email-form {
  margin-top: 8rpx;
}

.field {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--border);
  border-radius: 10rpx;
  background: #FFFFFF;
  font-size: var(--fs-body);
  color: var(--text);
  margin-bottom: 20rpx;
}

.code-row {
  display: flex;
  gap: 16rpx;
}

.code-field {
  flex: 1;
  margin-bottom: 20rpx;
}

.code-btn {
  width: 220rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin-bottom: 20rpx;
  background: var(--primary);
  color: #FFFFFF;
  font-size: var(--fs-meta);
  border-radius: 10rpx;
  padding: 0;
}

.code-btn::after {
  border: none;
}

.dev-hint {
  font-size: var(--fs-caption);
  color: var(--brick);
  margin: -6rpx 0 18rpx;
  text-align: center;
}

.back-link {
  text-align: center;
  margin-top: 24rpx;
  font-size: var(--fs-meta);
  color: var(--primary);
}

/* 协议勾选 */
.agreement-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 44rpx;
}

.checkbox {
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid #B9B4A8;
  border-radius: 50%;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkbox.checked {
  background: var(--primary);
  border-color: var(--primary);
}

.checkbox-mark {
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 1;
}

.agreement-text {
  font-size: var(--fs-caption);
  color: var(--text-hint);
}

.link {
  color: var(--primary);
}

/* 登录弹窗：半透明遮罩 + 居中纸卡，一屏填齐头像/昵称/手机号 */
.login-mask {
  position: fixed;
  inset: 0;
  background: rgba(20, 26, 34, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.login-sheet {
  position: relative;
  width: 640rpx;
  max-width: 90vw;
  background: var(--card-bg);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 60rpx 48rpx 44rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.25);
}

.login-sheet::before {
  content: '';
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  top: 20rpx;
  height: 1rpx;
  background: var(--border);
}

.sheet-close {
  position: absolute;
  right: 28rpx;
  top: 18rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 50rpx;
  text-align: center;
  font-size: 44rpx;
  color: var(--text-hint);
}

.sheet-brand {
  text-align: center;
  margin-bottom: 40rpx;
}

.brand-stamp {
  width: 92rpx;
  height: 92rpx;
  line-height: 92rpx;
  margin: 0 auto 20rpx;
  border-radius: 12rpx;
  background: var(--primary-deep);
  color: #FFFFFF;
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  box-shadow: 0 8rpx 18rpx rgba(27, 54, 84, 0.18);
}

.brand-title {
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  color: var(--primary-deep);
}

.brand-slogan {
  margin-top: 8rpx;
  font-size: var(--fs-caption);
  color: var(--text-hint);
  letter-spacing: 1rpx;
}

/* ---- 资料填写区 ---- */
.profile-form {
  margin-bottom: 36rpx;
}

.avatar-btn {
  position: relative;
  display: block;
  width: 132rpx;
  height: 132rpx;
  margin: 0 auto 32rpx;
  padding: 0;
  background: transparent;
  border: none;
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border);
  background: var(--bg-deep);
}

.avatar-edit {
  position: absolute;
  left: 50%;
  bottom: -8rpx;
  transform: translateX(-50%);
  white-space: nowrap;
  font-size: 20rpx;
  color: #FFFFFF;
  background: var(--primary);
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
}

.field-row {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.field-label {
  width: 96rpx;
  flex-shrink: 0;
  font-size: var(--fs-body);
  color: var(--text-secondary);
}

.field-input {
  flex: 1;
  height: 80rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--border);
  border-radius: 10rpx;
  background: #FFFFFF;
  font-size: var(--fs-body);
  color: var(--text);
}

.phone-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background: var(--primary-light);
  color: var(--primary-deep);
  font-size: var(--fs-body);
  border: 1rpx solid var(--primary-soft);
  border-radius: 10rpx;
  padding: 0 20rpx;
  text-align: left;
}

.phone-btn::after {
  border: none;
}

.phone-hint {
  margin: -6rpx 0 0 96rpx;
  font-size: var(--fs-caption);
  color: var(--moss);
}

/* 登录主按钮：黑色实心，仿 WorkBuddy */
.btn-login {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: #1A1A1A;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  border-radius: 14rpx;
  border: none;
  padding: 0;
}

.btn-login::after {
  border: none;
}

/* 协议勾选 */
.agreement-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 32rpx;
}

.checkbox {
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid #B9B4A8;
  border-radius: 50%;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkbox.checked {
  background: var(--primary);
  border-color: var(--primary);
}

.checkbox-mark {
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 1;
}

.agreement-text {
  font-size: var(--fs-caption);
  color: var(--text-hint);
}

.link {
  color: var(--primary);
}

.audit-detail-page {
  padding-bottom: 180rpx;
}

.image-swiper {
  height: 480rpx;
  background: #000000;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

.detail-title {
  font-size: 34rpx;
  font-weight: bold;
}

.meta {
  font-size: 22rpx;
  color: var(--text-hint);
  margin: 10rpx 0 24rpx;
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
  border-top: 1rpx solid var(--border);
  padding-top: 20rpx;
}

.info-cell {
  width: 33%;
  margin-bottom: 20rpx;
  font-size: 26rpx;
}

.info-label {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-bottom: 6rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-top: 16rpx;
}

.description {
  font-size: 28rpx;
  white-space: pre-wrap;
  margin-top: 12rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.reject-btn {
  flex: 1;
  color: var(--danger);
  border-color: var(--danger);
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
}

.approve-btn {
  flex: 2;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
}

.header {
  font-size: 30rpx;
  font-weight: bold;
  padding: 24rpx 32rpx 8rpx;
}

.login-card .form-item {
  margin-bottom: 24rpx;
}

.form-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.input {
  background: var(--bg);
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
}

.audit-card {
  display: flex;
}

.cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: var(--bg);
  flex-shrink: 0;
}

.info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.title {
  font-size: 28rpx;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta {
  font-size: 22rpx;
  color: var(--text-hint);
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.duration {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.logout {
  margin: 40rpx 24rpx;
}

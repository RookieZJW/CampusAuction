.header {
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 32rpx 8rpx;
  letter-spacing: 2rpx;
}

.login-card .form-item {
  margin-bottom: 24rpx;
}

.form-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.input {
  background: var(--bg-deep);
  border-radius: 6rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--border);
  font-size: 28rpx;
}

.audit-card {
  display: flex;
}

.cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  background: var(--bg-deep);
  border: 1rpx solid var(--border);
  flex-shrink: 0;
}

.info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.title {
  font-size: 28rpx;
  line-height: 1.45;
  letter-spacing: 0.5rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta {
  font-size: 22rpx;
  color: var(--text-hint);
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.duration {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.tabs {
  display: flex;
  margin: 16rpx 24rpx 0;
  background: var(--card-bg);
  border: 1rpx solid var(--border);
  border-radius: 10rpx;
  overflow: hidden;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: var(--fs-body);
  color: var(--text-secondary);
  letter-spacing: 1rpx;
}
.tab.active {
  background: var(--primary);
  color: #fff;
  font-weight: 600;
}

.sub-name {
  font-size: var(--fs-meta);
  color: var(--text-secondary);
  font-weight: 400;
}

.auth-actions {
  display: flex;
  margin-top: 8rpx;
}
.mini-btn {
  margin: 0;
  min-height: 0;
  height: 56rpx;
  line-height: 1.4;
  padding: 0 26rpx;
  border-radius: 999rpx;
  font-size: var(--fs-caption);
  display: flex;
  align-items: center;
  justify-content: center;
  text-indent: 1rpx;
}
.approve-btn {
  background: var(--moss);
  color: #fff;
  margin-right: 16rpx;
}
.reject-btn {
  background: transparent;
  border: 2rpx solid var(--danger);
  color: var(--danger);
}

.tap-tip {
  font-size: var(--fs-caption);
  color: var(--text-hint);
  text-align: center;
  padding: 16rpx 0 0;
}

.preview-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(16, 24, 32, 0.92);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.preview-image {
  width: 100%;
  height: 75vh;
}
.preview-close {
  color: #fff;
  font-size: var(--fs-caption);
  margin-top: 30rpx;
  opacity: 0.75;
}

.logout {
  margin: 40rpx 24rpx;
}

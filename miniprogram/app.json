      },
      {
        "pagePath": "pages/publish/publish",
        "text": "发布",
        "iconPath": "images/tab-publish.png",
        "selectedIconPath": "images/tab-publish-on.png"
      },
      {
        "pagePath": "pages/mine/mine",
        "text": "我的",
        "iconPath": "images/tab-mine.png",
        "selectedIconPath": "images/tab-mine-on.png"
      }
    ]
  },
  "window": {
    "navigationBarBackgroundColor": "#1B3654",
    "navigationBarTitleText": "校园拍场",
    "navigationBarTextStyle": "white",
    "backgroundColor": "#F5F2EA",
    "backgroundTextStyle": "dark"
  },
  "lazyCodeLoading": "requiredComponents",
  "style": "v2",
  "__usePrivacyCheck__": true,
  "sitemapLocation": "sitemap.json"

  ],
  "subpackages": [
    {
      "root": "packageUser",
      "name": "packageUser",
      "pages": [
        "pages/my-items/my-items",
        "pages/my-bids/my-bids",
        "pages/my-orders/my-orders",
        "pages/wallet/wallet",
        "pages/credit/credit",
        "pages/notifications/notifications",
        "pages/my-reviews/my-reviews",
        "pages/review/review",
        "pages/favorites/favorites",
        "pages/profile/profile"
      ]
    },
    {
      "root": "packageAdmin",
      "name": "packageAdmin",
      "pages": [
        "pages/audit/audit",
        "pages/audit-detail/audit-detail"
      ]
    }
  ],
  "preloadRule": {

.fav-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.fav-item:last-child {
  border-bottom: none;
}

.cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: var(--bg);
}

.info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.title {
  font-size: 28rpx;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta {
  margin: 10rpx 0;
}

.tag-ongoing {
  background: var(--success-light);
  color: var(--success);
}

.bottom-row {
  display: flex;
  align-items: baseline;
}

.price {
  color: var(--danger);
  font-weight: bold;
  font-size: 32rpx;
}

.remain {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--warning);
}

.bid-count {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--text-hint);
}

.cancel {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  color: var(--text-hint);
  font-size: 30rpx;
  flex-shrink: 0;
}

.review-page {
  padding-bottom: 160rpx;
}

.item-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.section-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

.stars-row {
  display: flex;
  align-items: center;
}

.star {
  font-size: 64rpx;
  color: var(--border);
  margin-right: 12rpx;
}

.star-on {
  color: var(--star);
}

.rating-text {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: var(--warning);
}

.content-input {
  background: var(--bg-deep);
  border-radius: 6rpx;
  padding: 20rpx;
  border: 1rpx solid var(--border);
  min-height: 200rpx;
  width: 100%;
  box-sizing: border-box;
  font-size: 28rpx;
}

.submit-area {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--card-bg);
  border-top: 1rpx solid var(--border);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

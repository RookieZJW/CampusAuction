/* 仿微信收银台：刻意使用微信绿，与项目纸感校园主题区分，便于答辩时一眼识别支付环节 */
.cashier {
  min-height: 100vh;
  background: #F5F5F5;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.loading {
  text-align: center;
  color: #888;
  font-size: 28rpx;
  padding-top: 120rpx;
}

/* ---------- 收银台 ---------- */
.pay-head {
  background: linear-gradient(160deg, #0ACF6B 0%, #07B957 100%);
  border-radius: 20rpx;
  padding: 48rpx 32rpx 44rpx;
  color: #FFFFFF;
  text-align: center;
  margin-bottom: 24rpx;
}

.head-mark {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin: 0 auto 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  font-size: 32rpx;
  font-weight: 600;
}

.head-name {
  font-size: 28rpx;
  opacity: 0.95;
  margin-bottom: 40rpx;
}

.pay-label {
  font-size: 24rpx;
  opacity: 0.85;
}

.pay-amount {
  font-size: 76rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  margin-top: 8rpx;
}

.cur {
  font-size: 40rpx;
  margin-right: 6rpx;
}

.head-badge {
  display: inline-block;
  margin-top: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  font-size: 22rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 12rpx 28rpx;
  margin-bottom: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 76rpx;
  border-bottom: 1rpx solid #F2F2F2;
  font-size: 26rpx;
}

.row:last-child {
  border-bottom: none;
}

.k {
  color: #8A8A8A;
  flex-shrink: 0;
}

.v {
  color: #2B2B2B;
  max-width: 66%;
  text-align: right;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.method-title {
  font-size: 24rpx;
  color: #8A8A8A;
  padding: 20rpx 0 8rpx;
}

.method-row {
  display: flex;
  align-items: center;
  min-height: 92rpx;
}

.wx-icon {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 10rpx;
  background: #07C160;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.method-name {
  flex: 1;
  font-size: 28rpx;
  color: #2B2B2B;
}

.method-sub {
  display: block;
  font-size: 20rpx;
  color: #9A9A9A;
  margin-top: 2rpx;
}

.radio-on {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #07C160;
  color: #FFFFFF;
  font-size: 24rpx;
  flex-shrink: 0;
}

.notice {
  font-size: 22rpx;
  color: #9A9A9A;
  line-height: 1.6;
  padding: 0 12rpx 28rpx;
}

.pay-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 14rpx;
  background: #07C160;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.4;
  border: none;
}

.pay-btn::after {
  border: none;
}

.cancel {
  text-align: center;
  font-size: 26rpx;
  color: #8A8A8A;
  padding: 32rpx 0 12rpx;
}

/* ---------- 支付成功 ---------- */
.success-page {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
}

.success-top {
  background: linear-gradient(160deg, #0ACF6B 0%, #07B957 100%);
  color: #FFFFFF;
  text-align: center;
  padding: 64rpx 32rpx 56rpx;
}

.check {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  font-size: 52rpx;
  font-weight: 600;
}

.success-label {
  font-size: 32rpx;
  margin-bottom: 12rpx;
}

.success-amount {
  font-size: 68rpx;
  font-weight: 600;
}

.mock-badge {
  display: inline-block;
  margin-top: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  font-size: 22rpx;
}

.receipt {
  padding: 16rpx 32rpx;
}

.receipt-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  border-bottom: 1rpx solid #F2F2F2;
  font-size: 25rpx;
}

.receipt-row:last-child {
  border-bottom: none;
}

.receipt-row .k {
  color: #8A8A8A;
  flex-shrink: 0;
}

.receipt-row .v {
  color: #2B2B2B;
  max-width: 66%;
  text-align: right;
}

.tip {
  font-size: 22rpx;
  color: #9A9A9A;
  line-height: 1.6;
  padding: 8rpx 32rpx 28rpx;
}

.done-btn {
  margin: 0 32rpx 48rpx;
  height: 88rpx;
  border-radius: 14rpx;
  background: #07C160;
  color: #FFFFFF;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.4;
  border: none;
}

.done-btn::after {
  border: none;
}

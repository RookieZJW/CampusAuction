.item-card {
  display: flex;
}

.cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  background: var(--bg-deep);
  border: 1rpx solid var(--border);
  flex-shrink: 0;
}

.info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.title {
  font-size: 28rpx;
  line-height: 1.45;
  letter-spacing: 0.5rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.status-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  background: var(--primary-light);
  color: var(--primary);
}

.status-tag.REJECTED,
.status-tag.CANCELLED {
  background: var(--danger-light);
  color: var(--danger);
}

.status-tag.FINISHED {
  background: var(--success-light);
  color: var(--success);
}

.bid-count {
  font-size: 22rpx;
  color: var(--text-hint);
}

.reject-reason {
  font-size: 22rpx;
  color: var(--danger);
  background: var(--danger-light);
  border-radius: 6rpx;
  padding: 8rpx 12rpx;
}

.tab-bar {
  display: flex;
  background: var(--card-bg);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
  position: relative;
}

.tab.active {
  color: var(--primary);
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  left: 30%;
  right: 30%;
  bottom: 8rpx;
  height: 4rpx;
  border-radius: 0;
  background: var(--primary);
}

.order-card {
  display: flex;
}

.cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  background: var(--bg-deep);
  border: 1rpx solid var(--border);
  flex-shrink: 0;
}

.info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.title {
  font-size: 28rpx;
  line-height: 1.45;
  letter-spacing: 0.5rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

.price {
  font-size: 32rpx;
}

.status-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  background: var(--primary-light);
  color: var(--primary);
}

.status-tag.COMPLETED {
  background: var(--success-light);
  color: var(--success);
}

.status-tag.CANCELLED {
  background: var(--danger-light);
  color: var(--danger);
}

.actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 12rpx;
}

.mini-btn {
  font-size: 24rpx;
  height: 56rpx;
  line-height: 1.4;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  border-radius: 8rpx;
  margin: 0;
}

.mini-btn.primary {
  background: var(--primary);
  color: #FFFFFF;
}

.mini-btn.ghost {
  border: 1rpx solid var(--primary);
  color: var(--primary);
  background: transparent;
}

/* W5：已评价标记 */
.reviewed-tip {
  font-size: 22rpx;
  color: var(--success);
  text-align: right;
}

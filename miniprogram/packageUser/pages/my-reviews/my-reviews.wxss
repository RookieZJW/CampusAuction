.tab-bar {
  display: flex;
  background: var(--card-bg);
  border-bottom: 1rpx solid var(--border);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
}

.tab.active {
  color: var(--primary);
  font-weight: 600;
  border-bottom: 4rpx solid var(--primary);
}

.review-item {
  padding: 24rpx 0;
  border-bottom: 1rpx dashed var(--border);
}

.review-item:last-child {
  border-bottom: none;
}

.head-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.who {
  font-size: 28rpx;
  font-weight: 600;
}

.time {
  font-size: 20rpx;
  color: var(--text-hint);
}

.stars {
  margin: 10rpx 0;
}

.star {
  font-size: 34rpx;
  color: var(--border);
  margin-right: 6rpx;
}

.star-on {
  color: var(--star);
}

.item-title {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.content {
  font-size: 26rpx;
  margin-top: 10rpx;
  background: var(--bg-deep);
  border-radius: 6rpx;
  padding: 16rpx 20rpx;
}

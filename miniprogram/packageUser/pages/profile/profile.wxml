<view class="profile-page">
  <!-- 说明：明确是选填，不制造强制授权感 -->
  <view class="notice card">
    <view class="notice-title">让同学认得出你</view>
    <view class="notice-text">头像和昵称由你自己选填，用于出价记录和面交联系。不填也能正常竞拍。</view>
  </view>

  <!-- 不同意隐私指引时仍可浏览，并保留随时重新同意的入口 -->
  <view wx:if="{{privacyDeclined}}" class="declined-tip card">
    <view class="declined-text">暂时没同意隐私指引，头像昵称和手机号还不能用。拍场照常能逛。</view>
    <button class="reagree-btn" open-type="agreePrivacyAuthorization"
            bindagreeprivacyauthorization="onAgreePrivacy">同意并继续填写</button>
  </view>

  <!-- 头像：微信「头像昵称填写能力」，用户主动选择 -->
  <view class="card">
    <view class="section-label">头像</view>
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="avatar-img" src="{{avatarDisplay || '/images/placeholder.png'}}" mode="aspectFill" />
      <view class="avatar-hint">点一下换头像</view>
    </button>
    <view class="field-hint" wx:if="{{uploading}}">正在上传…</view>
  </view>

  <!-- 昵称：input type=nickname，键盘上方会带出微信昵称 -->
  <view class="card">
    <view class="section-label">昵称</view>
    <input class="nickname-input" type="nickname" placeholder="填个同学认得出的名字"
           value="{{nickname}}" maxlength="32"
           bindinput="onNicknameInput" bindblur="onNicknameBlur" />
    <view class="field-hint">键盘上方可以直接选用你的昵称</view>
  </view>

  <!-- 手机号：手机号快速验证组件，可选，拒绝后不阻塞任何功能 -->
  <view class="card">
    <view class="section-label">手机号 <text class="optional">选填</text></view>
    <block wx:if="{{phoneBound}}">
      <view class="phone-row">
        <text class="phone-num">{{phone}}</text>
        <text class="phone-tag">已绑定</text>
      </view>
      <view class="field-hint">仅用于面交联系，不会展示给其他同学</view>
    </block>
    <block wx:else>
      <button class="phone-btn" open-type="getPhoneNumber" disabled="{{binding}}"
              bindgetphonenumber="onGetPhoneNumber">{{binding ? '绑定中…' : '手机号快捷填入'}}</button>
      <view class="field-hint">不授权也能用，可在面交时另行留联系方式</view>
    </block>
  </view>

  <!-- 校园认证资料：已持久化到 t_user，此处只读展示 -->
  <view wx:if="{{authStatus !== 'NONE'}}" class="card">
    <view class="section-label">校园认证 <text class="optional">已持久化</text></view>
    <view class="info-row"><text class="info-key">姓名</text><text class="info-value">{{realName || '—'}}</text></view>
    <view class="info-row"><text class="info-key">学号</text><text class="info-value">{{studentNo || '—'}}</text></view>
    <view class="info-row"><text class="info-key">学校</text><text class="info-value">{{schoolName || '—'}}</text></view>
    <view class="info-row"><text class="info-key">状态</text><text class="info-value">{{authText}}</text></view>
    <view class="field-hint">以上信息保存在用户资料中，可在「学校认证」修改后重新提交审核</view>
  </view>

  <view class="submit-area">
    <button class="btn-primary" bindtap="onSave" loading="{{saving}}">保存资料</button>
  </view>

  <!-- 隐私授权弹窗：用户主动同意，不默认勾选；不同意仍可浏览拍场 -->
  <view class="privacy-mask" wx:if="{{showPrivacy}}">
    <view class="privacy-panel">
      <view class="privacy-title">动笔之前，先看一眼</view>
      <view class="privacy-text">
        我们只在你主动填写时收集头像、昵称和手机号，用于出价记录展示与面交联系。可以先不同意，继续逛拍场，之后想填了再来这里。
      </view>
      <button class="privacy-link" bindtap="onOpenPrivacyContract">{{privacyContractName}}</button>
      <view class="privacy-actions">
        <button class="privacy-disagree" bindtap="onDisagreePrivacy">先不同意</button>
        <button id="agree-btn" class="privacy-agree"
                open-type="agreePrivacyAuthorization"
                bindagreeprivacyauthorization="onAgreePrivacy">同意并继续</button>
      </view>
    </view>
  </view>
</view>

.balance-card {
  margin: 20rpx 24rpx;
  padding: 48rpx 32rpx;
  border-radius: 10rpx;
  background: var(--primary);
  color: #FFFFFF;
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.14), 0 8rpx 18rpx rgba(27,54,84,0.14);
}

.balance-label {
  font-size: 24rpx;
  opacity: 0.8;
}

.balance {
  font-size: 64rpx;
  letter-spacing: 2rpx;
  font-weight: 600;
  margin: 12rpx 0;
}

.balance-tip {
  font-size: 20rpx;
  opacity: 0.7;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid var(--brick);
}

.log-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx dashed var(--border);
}

.log-item:last-child {
  border-bottom: none;
}

.log-type {
  font-size: 28rpx;
  font-weight: 600;
}

.log-remark {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.log-time {
  font-size: 20rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
}

.log-amount {
  font-size: 32rpx;
  font-weight: 600;
}

.log-amount.plus {
  color: var(--success);
}

.log-amount.minus {
  color: var(--danger);
}

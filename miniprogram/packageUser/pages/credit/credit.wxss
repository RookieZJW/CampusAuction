.score-card {
  margin: 20rpx 24rpx;
  padding: 48rpx 32rpx;
  border-radius: 16rpx;
  background: var(--success);
  color: #ffffff;
  text-align: center;
}

.score-card.excellent {
  background: var(--primary);
}

.score-card.low {
  background: var(--danger);
}

.score {
  font-size: 96rpx;
  font-weight: bold;
  line-height: 1.2;
}

.level {
  font-size: 28rpx;
  opacity: 0.9;
}

.rule-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 8rpx;
  padding: 10rpx 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.log-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.log-item:last-child {
  border-bottom: none;
}

.log-reason {
  font-size: 26rpx;
}

.log-time {
  font-size: 20rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
}

.log-change {
  font-size: 32rpx;
  font-weight: bold;
}

.log-change.plus {
  color: var(--success);
}

.log-change.minus {
  color: var(--danger);
}
